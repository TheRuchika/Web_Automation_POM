<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.1.dtd" >

<!--
 TestNG Suite: QA Registration Module
 This suite executes end-to-end user registration
 followed by login validation using POM framework.
-->

<suite name="QA_Reg_Module_Plan">

    <listeners>
        <listener class-name="com.aventstack.chaintest.plugins.ChainTestListener"/>
        <listener class-name="utils.ChainTestReportListenerManager"/>
    </listeners>

    <!--
     Test Group: Registration & Login Flow
     TC001 → User Registration
     TC002 → Login with Registered User (depends on TC001)
    -->
    <test name="Registration_and_Login_Tests">

        <classes>
            <class name="testCases.TC001_RegisterUserTest"/>
            <class name="testCases.TC002_RegisterLoginUserTest"/>
            <class name="testCases.TC001_RegisterUserTest_update"/>

        </classes>

    </test>

</suite>
